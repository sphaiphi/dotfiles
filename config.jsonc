// ~/.config/waybar/config.jsonc
//
// Lean by default: only modules that update on real events (workspace
// change, tray activity) or on a slow interval (clock, battery,
// network). No CPU/memory/temperature graphs polling every second —
// see the commented block at the bottom if you want them anyway.
//
// Plain text labels throughout, no icon glyphs — consistent with
// 10-appearance.conf's assumption that no Nerd Font is installed. If
// you do install one later, swap format-icons/format strings below for
// glyphs and it'll pick them up immediately.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["tray", "sway/language", "network", "pulseaudio", "battery", "clock"],

    "sway/language": {
        // Shows which of the two layouts from 20-input.conf is active.
        // No polling — sway pushes an update on layout switch.
        "format": "{short}"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "MODE: {}"
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% (chg)",
        "format-full": "BAT {capacity}%"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "eth: {ifname}",
        "format-disconnected": "disconnected",
        "tooltip-format": "{ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        // wpctl-first, pactl-fallback — see 40-bindings-core.conf for why
        // (Ubuntu 22.04 LTS defaults to PulseAudio, not PipeWire, for audio)
        "on-click": "sh -c 'command -v wpctl >/dev/null && wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle'",
        "on-scroll-up": "sh -c 'command -v wpctl >/dev/null && wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ || pactl set-sink-volume @DEFAULT_SINK@ +5%'",
        "on-scroll-down": "sh -c 'command -v wpctl >/dev/null && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- || pactl set-sink-volume @DEFAULT_SINK@ -5%'"
    }

    // --- Optional, commented out by default ---
    // Add "cpu" / "memory" / "temperature" to modules-right above if
    // you want them; each polls on its own interval below (5s is a
    // reasonable floor — anything faster is wasted work on a status bar).
    //, "cpu": { "interval": 5, "format": "{usage}% " }
    //, "memory": { "interval": 5, "format": "{percentage}% " }
    //, "temperature": { "interval": 5, "format": "{temperatureC}C" }
}
