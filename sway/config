# ~/.config/sway/config
#
# Entrypoint only. This file intentionally contains no settings of its
# own — everything lives in small, self-contained snippets under
# config.d/, loaded in numeric order. Delete or override any single
# snippet without touching the rest.
#
# Read `man 5 sway` for the complete reference.

### Environment
# NOT `include`d here — Sway's `include` only accepts sway config
# syntax (bindsym, set, etc.), not plain KEY=VALUE lines. Environment
# variables for the session are set separately, before Sway even
# starts, via systemd's environment.d(5) mechanism. See the setup
# instructions in ~/.config/environment.d/10-sway.conf (read at login,
# so changes there need a fresh login, not a sway reload).

### Core configuration snippets, loaded in order:
#   00 - variables      (includes the active theme from themes/<name>.conf,
#                        which holds ALL colors; then $mod, $term, $menu,
#                        $lock, $file_manager, workspace names)
#   10 - appearance      fonts, borders, gaps, titlebars, client colors
#   20 - input / output   keyboard, touchpad, gestures, displays, wallpaper
#   30 - autostart        dbus env, notifications, polkit, idle handler,
#                        clipboard history
#   40 - bindings-core     launch, focus, move, workspaces, layout
#   50 - modes             resize mode, screenshot mode
#   60 - window-rules       floating/dialog rules, shortcuts inhibitor
#   70 - bar                status bar
include config.d/*.conf

### Local, machine-specific overrides (git-ignored / not shared)
# Put per-host quirks here (e.g. output layout for a specific monitor
# setup, an input override for a specific keyboard). Safe to be absent.
# Loaded last, so it can override bindings, rules, outputs and inputs.
# It can NOT redefine variables ($term, $menu...) used by earlier lines:
# sway substitutes variables line by line as it reads. Override the
# bindsym itself instead.
include config.d.local/*.conf
